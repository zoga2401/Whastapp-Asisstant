{
  "name": "zoga-assistant-backend",
  "version": "1.0.0",
  "description": "Backend engine for Zoga Assistant - Local AI WhatsApp Automation",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src -e ts --exec ts-node -r dotenv/config src/server.ts",
    "test": "node --require ts-node/register --test src/__tests__/*.test.ts",
    "test:db": "ts-node src/test-db.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "ollama",
    "baileys",
    "postgresql"
  ],
  "author": "Zoga Team",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "@types/qrcode-terminal": "^1.0.35",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
