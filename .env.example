# ==============================================================================
# ZOGA ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env sebelum menjalankan sistem:
# cp .env.example .env
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL Lokal)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zoga_assistant
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Enable only when PostgreSQL requires TLS. Never disable certificate verification in production.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_STATEMENT_TIMEOUT_MS=30000

# Logging Configuration
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=../../logs/app.log

# Admin & Notification (Placeholder untuk tahap selanjutnya)
ADMIN_PHONE_NUMBER=6281234567890
ADMIN_SECRET_KEY=change_this_to_a_secure_random_string
ADMIN_DASHBOARD_USERNAME=admin
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+'$'+c.scryptSync('CHANGE_ME',s,32).toString('hex'))"
ADMIN_DASHBOARD_PASSWORD_HASH=
ADMIN_SESSION_TTL_MS=28800000

# AI / Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Keep inference bounded on low-resource hosts (Stage 12 production default).
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.3

# Stage 9 auto-reply (disabled by default; emergency kill switch overrides enable)
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_AUTO_REPLY_KILL_SWITCH=false
AUTO_REPLY_PER_CONTACT_PER_MINUTE=1
AUTO_REPLY_GLOBAL_PER_MINUTE=10
AUTO_REPLY_DEDUPE_TTL_MS=86400000
AUTO_REPLY_TYPING_ENABLED=true
AUTO_REPLY_LOOP_WINDOW_MS=600000
AUTO_REPLY_MAX_IN_FLIGHT_MS=60000
# Readiness policy (keep false if WhatsApp is intentionally paired later)
HEALTH_REQUIRE_WHATSAPP=false
